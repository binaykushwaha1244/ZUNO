# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated build directories
bin/
gen/
out/
build/
app/build/
.gradle/

# Local configuration file (SDK path, device settings)
local.properties

# Proguard folder generated by Eclipse / Gradle
proguard/

# Log Files and crash dumps
*.log
*.crash
*.dump
*.stacktrace
*.hprof

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures and profiling folder
captures/

# IntelliJ IDEA & Android Studio project files
*.iml
.idea/
.idea/caches/
.idea/libraries/
.idea/modules.xml
.idea/workspace.xml
.idea/navEditor.xml
.idea/assetWizardSettings.xml

# Keystore files, certificates and secrets
*.jks
*.keystore
*.key
*.p12
*.pem
*.credentials
*.secrets
signing.properties

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild
.cxx

# OS generated files
.DS_Store
Thumbs.db

# Root-level test screenshots (preserved in docs/assets/)
/*.png
!docs/assets/**

# Kotlin build temp
.kotlin/

# Environment variables & secrets
.env
.env.*

# Local SQLite databases, journals, backups and query files
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3
*.db-backup
*.sql

# Personal media files (videos, photos, audio)
*.mp4
*.mkv
*.webm
*.avi
*.mov
*.flv
*.wmv
*.3gp
*.m4v
*.ts
*.mp3
*.wav
*.aac
*.m4a

# Temporary test artifacts and device UI dumps
/ui.xml
/device_ui*.xml
/output.txt
